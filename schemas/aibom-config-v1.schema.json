{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://0disoft.example/schemas/aibom-config-v1.schema.json",
  "title": "AI-BOM Generator Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version"],
  "properties": {
    "schema_version": { "const": "1" },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string", "minLength": 1 }
      }
    },
    "warning_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "missing_metadata": { "enum": ["warn", "fail"] }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["marker"],
      "properties": {
        "marker": { "type": "string", "minLength": 1 }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "model_card": { "type": "string", "minLength": 1 }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "include": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1 }
        },
        "exclude": {
          "type": "array",
          "maxItems": 256,
          "items": { "type": "string", "minLength": 1 }
        },
        "discovery": { "type": "boolean" },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "matches_per_pattern": { "type": "integer", "minimum": 1, "maximum": 256 },
            "single_file_bytes": { "type": "integer", "minimum": 1, "maximum": 17179869184 },
            "total_bytes": { "type": "integer", "minimum": 1, "maximum": 26843545600 },
            "visited_entries": { "type": "integer", "minimum": 1, "maximum": 100000 }
          }
        }
      }
    },
    "dependencies": { "$ref": "#/$defs/dependencyReferenceList" },
    "datasets": { "$ref": "#/$defs/referenceList" },
    "prompts": { "$ref": "#/$defs/referenceList" },
    "evals": { "$ref": "#/$defs/referenceList" },
    "training": { "$ref": "#/$defs/referenceList" }
  },
  "$defs": {
    "dependencyReferenceList": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": { "type": ["string", "number", "boolean"] },
          "type": { "type": ["string", "number", "boolean"] },
          "path": { "type": "string", "minLength": 1 },
          "artifact": { "type": "string", "minLength": 1 },
          "parse": { "type": "boolean" }
        }
      }
    },
    "referenceList": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "name": { "type": ["string", "number", "boolean"] },
          "type": { "type": ["string", "number", "boolean"] },
          "path": { "type": "string", "minLength": 1 },
          "artifact": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
